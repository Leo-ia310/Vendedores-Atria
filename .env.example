# ============================================================
# Academia Comercial ARCA - Variables de entorno (ejemplo)
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor. Nunca expongas estas dos en codigo cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
AUTH_PEPPER=CAMBIA_ESTO_POR_UN_SECRETO_LARGO

# Nombre de marca mostrado en la UI.
NEXT_PUBLIC_BRAND=ARCA
NEXT_PUBLIC_PROGRAMA=Academia Comercial ARCA

# WhatsApp de soporte (formato internacional sin +, ej. 50588887777).
NEXT_PUBLIC_WHATSAPP_SOPORTE=50500000000

# Correo de soporte / contacto.
NEXT_PUBLIC_EMAIL_SOPORTE=soporte@arca.app

# Redes sociales (opcional).
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/
