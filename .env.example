# ============================================================
# Academia Comercial ATRIA - Variables de entorno (ejemplo)
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor. Nunca expongas estas dos en codigo cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
AUTH_PEPPER=CAMBIA_ESTO_POR_UN_SECRETO_LARGO

# Nombre de marca mostrado en la UI.
NEXT_PUBLIC_BRAND=ATRIA
NEXT_PUBLIC_PROGRAMA=Academia Comercial ATRIA
NEXT_PUBLIC_ATRIA_APP_URL=https://arca.onl

# Secreto compartido solo entre Atria y Vendedores ATRIA para registrar ventas pagadas por referido.
ATRIA_REFERRAL_WEBHOOK_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_COMPARTIDO

# Cloudflare Workers AI (solo servidor; no usar NEXT_PUBLIC_).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opcional. Por defecto usa @cf/meta/llama-3.2-3b-instruct.
CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.2-3b-instruct
# Opcional. Por defecto usa @cf/baai/bge-m3 para embeddings RAG.
CLOUDFLARE_WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-m3

# Limites opcionales del simulador IA.
AI_SIMULATOR_MAX_HISTORY_MESSAGES=12
AI_SIMULATOR_CHAT_MAX_TOKENS=140
AI_SIMULATOR_MESSAGES_PER_MINUTE=12

# Limites opcionales del asistente interno IA.
AI_ASSISTANT_MAX_QUESTION_CHARS=1200
AI_ASSISTANT_MAX_HISTORY_MESSAGES=8
AI_ASSISTANT_TOP_K=5
AI_ASSISTANT_MIN_SIMILARITY=0.18
AI_ASSISTANT_MAX_CONTEXT_CHARS=5200
AI_ASSISTANT_MAX_TOKENS=360
AI_ASSISTANT_MESSAGES_PER_MINUTE=12
AI_ASSISTANT_CHUNK_MAX_CHARS=1200
AI_ASSISTANT_CHUNK_OVERLAP_CHARS=160

# WhatsApp de soporte (formato internacional sin +, ej. 50588887777).
NEXT_PUBLIC_WHATSAPP_SOPORTE=50588662303

# Enlace de invitación al grupo de WhatsApp de vendedores certificados.
NEXT_PUBLIC_WHATSAPP_GRUPO=https://chat.whatsapp.com/JLg2SfFrHZKDAr24FH5wdR

# Correo de soporte / contacto.
NEXT_PUBLIC_EMAIL_SOPORTE=soporte@atria.app

# Redes sociales (opcional).
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/
